{
  "id": "./",
  "name": "Weekz — Weekly Routine Planner",
  "short_name": "Weekz",
  "description": "A calm, colorful weekly routine planner.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#090d18",
  "theme_color": "#0b1020",
  "categories": ["productivity", "lifestyle"],
  "icons": [
    {
      "src": "./icons/weekz-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ]
}
